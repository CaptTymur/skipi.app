<?xml version="1.0" encoding="utf-8"?>
<!--
  The app CACHE is now grantable only through the two staging folders Skipi
  actually hands out. `cache-path path="."` used to expose the whole cache tree,
  so any future "share the vault file directly, without a copy" shortcut would
  have been grantable by accident. The only two callers of `app_cache_dir()` in
  the tree are the Share staging copy (skipi-share, commands/mail_intent.rs) and
  the document preview copy (skipi-preview, commands/documents.rs); both keep
  working.

  `external-path path="."` below is NOT narrowed by this slice, and saying "and
  nothing else" would be false: it still declares the whole external root. It is
  latent rather than active — both `getUriForFile` call sites build their paths
  from `app_cache_dir()`, so nothing reaches it today — and narrowing it touches
  the camera/gallery pickers this slice has no acceptance for. Named as a
  remaining path, not as work done.
-->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
  <external-path name="my_images" path="." />
  <cache-path name="skipi_share" path="skipi-share/" />
  <cache-path name="skipi_preview" path="skipi-preview/" />
</paths>
